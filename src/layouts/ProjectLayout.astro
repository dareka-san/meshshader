<style>
  .project-shell {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-rows: 1fr auto;
    align-items: end;
    gap: 1rem;
    min-height: 100svh;
    padding: clamp(1rem, 0.4286rem + 2.8571vw, 2.5rem);
    pointer-events: none;
  }

  .information__about {
    grid-column: 1 / -1;
    align-self: start;
  }

  .information__about,
  .information__header {
    position: relative;
    z-index: 10;
  }

  .information__logo {
    align-items: center;
  }

  .information__logo .typo {
    height: auto;
  }

  .information__job {
    color: #1f1f1f;
  }

  .information__header,
  .information__link {
    position: relative;
    padding: 0;
  }

  .information__head {
    overflow-wrap: anywhere;
    word-break: normal;
  }

  .information__list {
    flex-wrap: wrap;
  }

  .information__link-container {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    pointer-events: auto;
  }

  .information__link-container svg {
    width: 40px;
    height: 39px;
  }

  .information__link-container:focus-visible {
    outline: 3px solid currentColor;
    outline-offset: 2px;
  }

  @media (max-width: 26rem) {
    .information__head {
      font-size: 2.25rem;
    }
  }
</style>
